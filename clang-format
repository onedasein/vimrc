---
# 全局 C/C++ 风格（clang-format 会从文件所在目录逐级向上查找，项目里的
Language: Cpp
BasedOnStyle: Google
# .clang-format 优先级更高，可覆盖本文件）

#----- 基础骨架：缩进与行宽 -----
ColumnLimit: 120 # 行宽上限
IndentWidth: 4 # 与 vim 的 shiftwidth=4 保持一致
TabWidth: 4
UseTab: Never # 只用空格（配合 vim 的 expandtab）
IndentCaseLabels: true # switch-case缩进

#----- 大括号与换行 -----
BreakBeforeBraces: Attach # 花括号风格：K&R/Attach；要 Allman（另起一行）改成 Allman
#----- 指针与引用 -----
PointerAlignment: Left # 指针/引用贴类型：int* p（Right 则写成 int *p）
#----- 对齐策略 -----
# 对齐连续的宏定义
AlignConsecutiveMacros: AcrossEmptyLinesAndComments
# 对齐尾部注释
AlignTrailingComments: Leave
# 访问修饰符偏移
AccessModifierOffset: -4 # -4就是public顶格

#----- 短代码折叠-----
# 允许短函数在单行上
AllowShortFunctionsOnASingleLine: Empty
# 允许短语法块在单行上
AllowShortBlocksOnASingleLine: Empty
# 允许短匿Lambda函数在单行上
AllowShortLambdasOnASingleLine: All

#----- 包含文件排序 -----
# 对头文件排序
SortIncludes: Never
# 控制空格和标点符号风格
SpaceBeforeParens: ControlStatements # 控制语句的括号前有空格
SpaceBeforeAssignmentOperators: true # 赋值操作符前插入空格
# 控制每行最大空行数（避免空行过多）
MaxEmptyLinesToKeep: 1
# 注释前保留一个空格
SpacesBeforeTrailingComments: 1

#----- 初始化列表 -----
# 强制每个初始化项都单独占一行，无论它们多短
PackConstructorInitializers: Never
# 冒号，逗号都换到下一行行首
BreakConstructorInitializers: BeforeComma
# 初始化列表的缩进宽度（可选，通常设为 4 或 8）
ConstructorInitializerIndentWidth: 4

#----- 数组/花括号列表的换行策略（2026-10 新增）-----
# 目标：数组元素较多或较长时，一个元素占一行（比 bin-pack 成两三行更直观）。
#
# BinPackArguments: false
#   语义 =「要么全部在一行，要么一元素一行」，禁止「能塞几个塞几个」。
#   短数组不受影响（const int k[] = {1, 2, 3}; 仍是一行），也不需要写尾逗号。
#
# AlignAfterOpenBracket: BlockIndent
#   换行时用块缩进，而不是对齐到 { 的位置。
#   只加 BinPackArguments 会排成下面这样（结尾的花括号还会粘在最后），所以两个要一起用：
#       const char *k[] = {"aaa",
#                          "bbb"};
#
# 代价：AlignAfterOpenBracket 是全局的，所以超过 ColumnLimit 的长函数调用/声明
#       也会变成「括号后换行 + 块缩进」。这一点没法只针对数组单独设置——因为
#       Cpp11BracedListStyle 的设计就是让花括号列表按函数调用的方式排版。
#       只想改某一个数组时，用 // clang-format off / on 把那段包起来。
#
# 注：加尾逗号**不能**达到这个效果——它只保证花括号不被收成一行，
#     元素仍会被 bin-pack（2026-10 用 clang-format 18 在本机实测确认）。
BinPackArguments: false
AlignAfterOpenBracket: BlockIndent

# 其它常用开关：
#   BreakBeforeBraces: Stroustrup   # 函数另起一行、控制语句贴住
#   AlignConsecutiveAssignments: true
#   SpaceBeforeParens: ControlStatements

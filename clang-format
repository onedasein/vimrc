---
# 全局 C/C++ 风格（clang-format 会从文件所在目录逐级向上查找，项目里的
Language: Cpp
BasedOnStyle: Google
# .clang-format 优先级更高，可覆盖本文件）

#----- 基础骨架：缩进与行宽 -----
ColumnLimit: 120 # 行宽上限
IndentWidth: 4 # 与 vim 的 shiftwidth=4 保持一致
TabWidth: 4
UseTab: Never # 只用空格（配合 vim 的 expandtab）
IndentCaseLabels: true # switch-case缩进

#----- 大括号与换行 -----
BreakBeforeBraces: Attach # 花括号风格：K&R/Attach；要 Allman（另起一行）改成 Allman
#----- 指针与引用 -----
PointerAlignment: Left # 指针/引用贴类型：int* p（Right 则写成 int *p）
#----- 对齐策略 -----
# 对齐连续的宏定义
AlignConsecutiveMacros: AcrossEmptyLinesAndComments
# 对齐尾部注释
AlignTrailingComments: Leave
# 访问修饰符偏移
AccessModifierOffset: -4 # -4就是public顶格

#----- 短代码折叠-----
# 允许短函数在单行上
AllowShortFunctionsOnASingleLine: Empty
# 允许短语法块在单行上
AllowShortBlocksOnASingleLine: Empty
# 允许短匿Lambda函数在单行上
AllowShortLambdasOnASingleLine: All

#----- 包含文件排序 -----
# 对头文件排序
SortIncludes: Never
# 控制空格和标点符号风格
SpaceBeforeParens: ControlStatements # 控制语句的括号前有空格
SpaceBeforeAssignmentOperators: true # 赋值操作符前插入空格
# 控制每行最大空行数（避免空行过多）
MaxEmptyLinesToKeep: 1
# 注释前保留一个空格
SpacesBeforeTrailingComments: 1

#----- 初始化列表 -----
# 强制每个初始化项都单独占一行，无论它们多短
PackConstructorInitializers: Never
# 冒号，逗号都换到下一行行首
BreakConstructorInitializers: BeforeComma
# 初始化列表的缩进宽度（可选，通常设为 4 或 8）
ConstructorInitializerIndentWidth: 4
# 其它常用开关：
#   BreakBeforeBraces: Stroustrup   # 函数另起一行、控制语句贴住
#   AlignConsecutiveAssignments: true
#   SpaceBeforeParens: ControlStatements
